  <bpmn:process id="Process_LeaveApproval" name="Employee Leave Approval" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Leave request submitted" />
    <bpmn:task id="Task_CheckBalance" name="Check leave balance">
      <bpmn:outgoing>Flow_1ed2zu7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Balance" name="Sufficient balance?">
      <bpmn:incoming>Flow_1ed2zu7</bpmn:incoming>
      <bpmn:outgoing>Flow_1rgdthh</bpmn:outgoing>
      <bpmn:outgoing>Flow_0lv4ws0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SendInsufficient" name="Send insufficient-balance notification">
      <bpmn:incoming>Flow_1rgdthh</bpmn:incoming>
      <bpmn:outgoing>Flow_101q8np</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Insufficient" name="End">
      <bpmn:incoming>Flow_101q8np</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_SendManager" name="Send request to manager">
      <bpmn:incoming>Flow_0lv4ws0</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Approval" name="Manager approves?">
      <bpmn:outgoing>Flow_1mr0la9</bpmn:outgoing>
      <bpmn:outgoing>Flow_1fq0zur</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_UpdateBalance" name="Update leave balance">
      <bpmn:incoming>Flow_1mr0la9</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_ApprovalNotify" name="Send approval notification" />
    <bpmn:endEvent id="End_Approved" name="Approved" />
    <bpmn:task id="Task_RejectionNotify" name="Send rejection notification">
      <bpmn:incoming>Flow_1fq0zur</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="End_Rejected" name="Rejected" />
    <bpmn:sequenceFlow id="F1" sourceRef="StartEvent_1" targetRef="Task_CheckBalance" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_SendManager" targetRef="Gateway_Approval" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_UpdateBalance" targetRef="Task_ApprovalNotify" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_ApprovalNotify" targetRef="End_Approved" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_RejectionNotify" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_1rgdthh" name="No" sourceRef="Gateway_Balance" targetRef="Task_SendInsufficient" />
    <bpmn:sequenceFlow id="Flow_1ed2zu7" sourceRef="Task_CheckBalance" targetRef="Gateway_Balance" />
    <bpmn:sequenceFlow id="Flow_0lv4ws0" name="Yes" sourceRef="Gateway_Balance" targetRef="Task_SendManager" />
    <bpmn:sequenceFlow id="Flow_1mr0la9" name="Yes" sourceRef="Gateway_Approval" targetRef="Task_UpdateBalance" />
    <bpmn:sequenceFlow id="Flow_101q8np" sourceRef="Task_SendInsufficient" targetRef="End_Insufficient" />
    <bpmn:sequenceFlow id="Flow_1fq0zur" name="No" sourceRef="Gateway_Approval" targetRef="Task_RejectionNotify" />
  </bpmn:process>
