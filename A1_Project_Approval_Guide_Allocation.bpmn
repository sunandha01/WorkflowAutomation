<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SPA" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.0.0">
  <bpmn:collaboration id="Collab_SPA">
    <bpmn:participant id="Pool_SPA" name="Student Project Approval &amp; Allocation" processRef="Process_SPA" />
  </bpmn:collaboration>
  <bpmn:message id="Msg_Withdrawal" name="Withdrawal notice (team dissolved / guide on leave)" />
  <bpmn:message id="Msg_Reminder" name="SLA reminder" />
  <bpmn:error id="Err_InvalidTeam" name="Team rule violation" errorCode="TEAM_RULE_VIOLATION" />
  <bpmn:error id="Err_Notify" name="Notification / database failure" errorCode="NOTIFY_FAILED" />
  <bpmn:escalation id="Esc_HoD" name="Overdue committee review" escalationCode="REVIEW_OVERDUE" />
  <bpmn:process id="Process_SPA" name="Final-Year Project Proposal Approval &amp; Guide Allocation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SPA">
      <bpmn:lane id="Lane_Student" name="Student Team">
        <bpmn:flowNodeRef>Start_TeamReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_RevisionWindow</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PMS" name="Project Management System">
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Validation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvalidTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Similarity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rule_MatchGuide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_GuideFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReserveSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleaseSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExcludeGuide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Attempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Finalise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeNotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_JoinFinalise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Allocated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Comp_Reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Err_NotifyFail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coord" name="Project Coordinator">
        <bpmn:flowNodeRef>Task_LateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_LateApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualAllocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualNotify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Committee" name="Review Committee (incl. HoD)">
        <bpmn:flowNodeRef>Sub_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Escalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_NewTopicUsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_SLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Escalate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Guide" name="Faculty Guide">
        <bpmn:flowNodeRef>Task_GuideRespond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_GuideAccepts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Onboarding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_GuideSilent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Msg_Withdraw</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
<bpmn:startEvent id="Start_TeamReady" name="Team ready to propose a project">
      <bpmn:outgoing>Flow_SPA_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Submit" name="Prepare &amp; submit proposal">
      <bpmn:incoming>Flow_SPA_01</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_05</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_09</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_17</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_28</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Revise" name="Revise &amp; resubmit proposal">
      <bpmn:incoming>Flow_SPA_22</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Validate" name="Validate form &amp; team rules">
      <bpmn:incoming>Flow_SPA_02</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Validation" name="Validation result?" default="Flow_SPA_10">
      <bpmn:incoming>Flow_SPA_07</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_SPA_09</bpmn:outgoing>
      <bpmn:outgoing>Flow_SPA_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_InvalidTeam" name="Invalid team – team notified">
      <bpmn:incoming>Flow_SPA_08</bpmn:incoming>
      <bpmn:errorEventDefinition id="End_InvalidTeam_ED" errorRef="Err_InvalidTeam" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Similarity" name="Run duplicate-topic check">
      <bpmn:incoming>Flow_SPA_11</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Duplicate" name="Similarity above threshold?" default="Flow_SPA_13">
      <bpmn:incoming>Flow_SPA_12</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_SPA_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Rule_MatchGuide" name="Match guide by domain &amp; workload">
      <bpmn:incoming>Flow_SPA_23</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_41</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_44</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_30</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_GuideFound" name="Eligible guide found?" default="Flow_SPA_31">
      <bpmn:incoming>Flow_SPA_30</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_SPA_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReserveSlot" name="Reserve guide slot">
      <bpmn:incoming>Flow_SPA_31</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_33</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReleaseSlot" name="Release guide slot" isForCompensation="true" />
    <bpmn:sendTask id="Task_SendRequest" name="Send allocation request to guide">
      <bpmn:incoming>Flow_SPA_34</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_35</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_ExcludeGuide" name="Exclude guide &amp; count attempt">
      <bpmn:incoming>Flow_SPA_38</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_39</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_40</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Attempts" name="Attempts &lt; 3?" default="Flow_SPA_42">
      <bpmn:incoming>Flow_SPA_40</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_41</bpmn:outgoing>
      <bpmn:outgoing>Flow_SPA_42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gw_Finalise">
      <bpmn:incoming>Flow_SPA_45</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_46</bpmn:outgoing>
      <bpmn:outgoing>Flow_SPA_47</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Record" name="Record allocation">
      <bpmn:incoming>Flow_SPA_46</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_51</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Notify" name="Notify team &amp; guide (retry ×3)">
      <bpmn:incoming>Flow_SPA_47</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_48</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics id="Task_Notify_Loop" testBefore="false" loopMaximum="3" />
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gw_MergeNotify">
      <bpmn:incoming>Flow_SPA_48</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_50</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_52</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gw_JoinFinalise">
      <bpmn:incoming>Flow_SPA_51</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_52</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_53</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_Allocated" name="Project allocated">
      <bpmn:incoming>Flow_SPA_53</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_LateRequest" name="Decide on late-submission request">
      <bpmn:incoming>Flow_SPA_03</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_LateApproved" name="Late request approved?" default="Flow_SPA_06">
      <bpmn:incoming>Flow_SPA_04</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_SPA_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Lapsed" name="Proposal lapsed">
      <bpmn:incoming>Flow_SPA_06</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Screen" name="Screen proposal">
      <bpmn:incoming>Flow_SPA_10</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewMatch" name="Review similarity match">
      <bpmn:incoming>Flow_SPA_14</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Verdict" name="Coordinator verdict?">
      <bpmn:incoming>Flow_SPA_15</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_SPA_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_SPA_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Reminder" name="SLA reminder sent">
      <bpmn:incoming>Flow_SPA_19</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_Reminder_ED" messageRef="Msg_Reminder" />
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ManualAllocate" name="Allocate manually (co-guide / external / waitlist)">
      <bpmn:incoming>Flow_SPA_32</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_42</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ManualNotify" name="Notify team manually">
      <bpmn:incoming>Flow_SPA_49</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_50</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="Sub_Review" name="Committee review" triggeredByEvent="false">
      <bpmn:incoming>Flow_SPA_13</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_16</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_26</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_21</bpmn:outgoing>
      <bpmn:startEvent id="CR_Start" name="Assigned">
        <bpmn:outgoing>Flow_SPA_54</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="CR_Split">
        <bpmn:incoming>Flow_SPA_54</bpmn:incoming>
        <bpmn:outgoing>Flow_SPA_55</bpmn:outgoing>
        <bpmn:outgoing>Flow_SPA_56</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="CR_Tech" name="Assess feasibility &amp; scope">
        <bpmn:incoming>Flow_SPA_55</bpmn:incoming>
        <bpmn:outgoing>Flow_SPA_57</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="CR_Fit" name="Check syllabus fit &amp; novelty">
        <bpmn:incoming>Flow_SPA_56</bpmn:incoming>
        <bpmn:outgoing>Flow_SPA_58</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:parallelGateway id="CR_Join">
        <bpmn:incoming>Flow_SPA_57</bpmn:incoming>
        <bpmn:incoming>Flow_SPA_58</bpmn:incoming>
        <bpmn:outgoing>Flow_SPA_59</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="CR_End" name="Recommendation ready">
        <bpmn:incoming>Flow_SPA_59</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SPA_54" sourceRef="CR_Start" targetRef="CR_Split" />
      <bpmn:sequenceFlow id="Flow_SPA_55" sourceRef="CR_Split" targetRef="CR_Tech" />
      <bpmn:sequenceFlow id="Flow_SPA_56" sourceRef="CR_Split" targetRef="CR_Fit" />
      <bpmn:sequenceFlow id="Flow_SPA_57" sourceRef="CR_Tech" targetRef="CR_Join" />
      <bpmn:sequenceFlow id="Flow_SPA_58" sourceRef="CR_Fit" targetRef="CR_Join" />
      <bpmn:sequenceFlow id="Flow_SPA_59" sourceRef="CR_Join" targetRef="CR_End" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Escalated" name="Escalated to HoD">
      <bpmn:incoming>Flow_SPA_20</bpmn:incoming>
      <bpmn:escalationEventDefinition id="End_Escalated_ED" escalationRef="Esc_HoD" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Decision" name="Committee decision?" default="Flow_SPA_23">
      <bpmn:incoming>Flow_SPA_21</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_SPA_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_SPA_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendRejection" name="Send rejection reasons">
      <bpmn:incoming>Flow_SPA_18</bpmn:incoming>
      <bpmn:incoming>Flow_SPA_24</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_27</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gw_NewTopicUsed" name="New topic already used?" default="Flow_SPA_29">
      <bpmn:incoming>Flow_SPA_27</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_28</bpmn:outgoing>
      <bpmn:outgoing>Flow_SPA_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="Proposal rejected">
      <bpmn:incoming>Flow_SPA_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_GuideRespond" name="Respond to allocation request">
      <bpmn:incoming>Flow_SPA_35</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_GuideAccepts" name="Accept team?" default="Flow_SPA_37">
      <bpmn:incoming>Flow_SPA_36</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_37</bpmn:outgoing>
      <bpmn:outgoing>Flow_SPA_38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_Onboarding" name="Guide onboarding" triggeredByEvent="false">
      <bpmn:incoming>Flow_SPA_37</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_45</bpmn:outgoing>
      <bpmn:startEvent id="GO_Start" name="Guide accepted">
        <bpmn:outgoing>Flow_SPA_60</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="GO_Plan" name="Kick-off &amp; sign supervision plan">
        <bpmn:incoming>Flow_SPA_60</bpmn:incoming>
        <bpmn:outgoing>Flow_SPA_61</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="GO_End" name="Guide confirmed">
        <bpmn:incoming>Flow_SPA_61</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SPA_60" sourceRef="GO_Start" targetRef="GO_Plan" />
      <bpmn:sequenceFlow id="Flow_SPA_61" sourceRef="GO_Plan" targetRef="GO_End" />
    </bpmn:subProcess>
    <bpmn:intermediateThrowEvent id="Throw_Release" name="Release slot (compensate)">
      <bpmn:incoming>Flow_SPA_43</bpmn:incoming>
      <bpmn:outgoing>Flow_SPA_44</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Throw_Release_ED" activityRef="Task_ReserveSlot" waitForCompletion="true" />
    </bpmn:intermediateThrowEvent>
    <bpmn:boundaryEvent id="Timer_Deadline" name="F4: Deadline passed – team flagged" attachedToRef="Task_Submit">
      <bpmn:outgoing>Flow_SPA_03</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Deadline_ED"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">${proposalDeadline}</bpmn:timeDate></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_RevisionWindow" name="F5: No revision in 7 days" attachedToRef="Task_Revise">
      <bpmn:outgoing>Flow_SPA_25</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_RevisionWindow_ED"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Comp_Reserve" name="" attachedToRef="Task_ReserveSlot">
      <bpmn:compensateEventDefinition id="Comp_Reserve_ED" waitForCompletion="true" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Err_NotifyFail" name="F10: Still failing after 3 tries" attachedToRef="Task_Notify">
      <bpmn:outgoing>Flow_SPA_49</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Err_NotifyFail_ED" errorRef="Err_Notify" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_SLA" name="F7: 7-day SLA missed" attachedToRef="Sub_Review" cancelActivity="false">
      <bpmn:outgoing>Flow_SPA_19</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_SLA_ED"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_Escalate" name="F7: Second timeout (10 days)" attachedToRef="Sub_Review" cancelActivity="false">
      <bpmn:outgoing>Flow_SPA_20</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Escalate_ED"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_GuideSilent" name="F9: No reply in 2 days" attachedToRef="Task_GuideRespond">
      <bpmn:outgoing>Flow_SPA_39</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_GuideSilent_ED"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Msg_Withdraw" name="F11: Team / guide withdraws" attachedToRef="Sub_Onboarding">
      <bpmn:outgoing>Flow_SPA_43</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_Withdraw_ED" messageRef="Msg_Withdrawal" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_SPA_01" sourceRef="Start_TeamReady" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_SPA_02" sourceRef="Task_Submit" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_SPA_03" sourceRef="Timer_Deadline" targetRef="Task_LateRequest" />
    <bpmn:sequenceFlow id="Flow_SPA_04" sourceRef="Task_LateRequest" targetRef="Gw_LateApproved" />
    <bpmn:sequenceFlow id="Flow_SPA_05" name="Yes – reopen" sourceRef="Gw_LateApproved" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_SPA_06" name="No" sourceRef="Gw_LateApproved" targetRef="End_Lapsed" />
    <bpmn:sequenceFlow id="Flow_SPA_07" sourceRef="Task_Validate" targetRef="Gw_Validation" />
    <bpmn:sequenceFlow id="Flow_SPA_08" name="F2: Team rule broken" sourceRef="Gw_Validation" targetRef="End_InvalidTeam" />
    <bpmn:sequenceFlow id="Flow_SPA_09" name="F1: Errors – return list (attempt &lt; 2)" sourceRef="Gw_Validation" targetRef="Task_Submit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errors &amp;&amp; attempts &lt; 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SPA_10" name="Valid / escalate after 2 attempts" sourceRef="Gw_Validation" targetRef="Task_Screen" />
    <bpmn:sequenceFlow id="Flow_SPA_11" sourceRef="Task_Screen" targetRef="Task_Similarity" />
    <bpmn:sequenceFlow id="Flow_SPA_12" sourceRef="Task_Similarity" targetRef="Gw_Duplicate" />
    <bpmn:sequenceFlow id="Flow_SPA_13" name="No" sourceRef="Gw_Duplicate" targetRef="Sub_Review" />
    <bpmn:sequenceFlow id="Flow_SPA_14" name="F3: Yes" sourceRef="Gw_Duplicate" targetRef="Task_ReviewMatch" />
    <bpmn:sequenceFlow id="Flow_SPA_15" sourceRef="Task_ReviewMatch" targetRef="Gw_Verdict" />
    <bpmn:sequenceFlow id="Flow_SPA_16" name="False positive" sourceRef="Gw_Verdict" targetRef="Sub_Review" />
    <bpmn:sequenceFlow id="Flow_SPA_17" name="Modify topic" sourceRef="Gw_Verdict" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_SPA_18" name="Plagiarised" sourceRef="Gw_Verdict" targetRef="Task_SendRejection" />
    <bpmn:sequenceFlow id="Flow_SPA_19" sourceRef="Timer_SLA" targetRef="End_Reminder" />
    <bpmn:sequenceFlow id="Flow_SPA_20" sourceRef="Timer_Escalate" targetRef="End_Escalated" />
    <bpmn:sequenceFlow id="Flow_SPA_21" sourceRef="Sub_Review" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="Flow_SPA_22" name="F5: Revise (cycles &lt; 2)" sourceRef="Gw_Decision" targetRef="Task_Revise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${revisionCycles &lt; 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SPA_23" name="Approve" sourceRef="Gw_Decision" targetRef="Rule_MatchGuide" />
    <bpmn:sequenceFlow id="Flow_SPA_24" name="F6: Reject" sourceRef="Gw_Decision" targetRef="Task_SendRejection" />
    <bpmn:sequenceFlow id="Flow_SPA_25" sourceRef="Timer_RevisionWindow" targetRef="End_Lapsed" />
    <bpmn:sequenceFlow id="Flow_SPA_26" name="Resubmit" sourceRef="Task_Revise" targetRef="Sub_Review" />
    <bpmn:sequenceFlow id="Flow_SPA_27" sourceRef="Task_SendRejection" targetRef="Gw_NewTopicUsed" />
    <bpmn:sequenceFlow id="Flow_SPA_28" name="No – one new topic" sourceRef="Gw_NewTopicUsed" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_SPA_29" name="Yes" sourceRef="Gw_NewTopicUsed" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_SPA_30" sourceRef="Rule_MatchGuide" targetRef="Gw_GuideFound" />
    <bpmn:sequenceFlow id="Flow_SPA_31" name="Yes" sourceRef="Gw_GuideFound" targetRef="Task_ReserveSlot" />
    <bpmn:sequenceFlow id="Flow_SPA_32" name="F8: No" sourceRef="Gw_GuideFound" targetRef="Task_ManualAllocate" />
    <bpmn:sequenceFlow id="Flow_SPA_33" sourceRef="Task_ManualAllocate" targetRef="Task_ReserveSlot" />
    <bpmn:sequenceFlow id="Flow_SPA_34" sourceRef="Task_ReserveSlot" targetRef="Task_SendRequest" />
    <bpmn:sequenceFlow id="Flow_SPA_35" sourceRef="Task_SendRequest" targetRef="Task_GuideRespond" />
    <bpmn:sequenceFlow id="Flow_SPA_36" sourceRef="Task_GuideRespond" targetRef="Gw_GuideAccepts" />
    <bpmn:sequenceFlow id="Flow_SPA_37" name="Accept" sourceRef="Gw_GuideAccepts" targetRef="Sub_Onboarding" />
    <bpmn:sequenceFlow id="Flow_SPA_38" name="F9: Decline" sourceRef="Gw_GuideAccepts" targetRef="Task_ExcludeGuide" />
    <bpmn:sequenceFlow id="Flow_SPA_39" sourceRef="Timer_GuideSilent" targetRef="Task_ExcludeGuide" />
    <bpmn:sequenceFlow id="Flow_SPA_40" sourceRef="Task_ExcludeGuide" targetRef="Gw_Attempts" />
    <bpmn:sequenceFlow id="Flow_SPA_41" name="Yes – rerun rule" sourceRef="Gw_Attempts" targetRef="Rule_MatchGuide">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${attempts &lt; 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SPA_42" name="No – manual" sourceRef="Gw_Attempts" targetRef="Task_ManualAllocate" />
    <bpmn:sequenceFlow id="Flow_SPA_43" sourceRef="Msg_Withdraw" targetRef="Throw_Release" />
    <bpmn:sequenceFlow id="Flow_SPA_44" name="Reallocate" sourceRef="Throw_Release" targetRef="Rule_MatchGuide" />
    <bpmn:sequenceFlow id="Flow_SPA_45" sourceRef="Sub_Onboarding" targetRef="Gw_Finalise" />
    <bpmn:sequenceFlow id="Flow_SPA_46" sourceRef="Gw_Finalise" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="Flow_SPA_47" sourceRef="Gw_Finalise" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_SPA_48" sourceRef="Task_Notify" targetRef="Gw_MergeNotify" />
    <bpmn:sequenceFlow id="Flow_SPA_49" sourceRef="Err_NotifyFail" targetRef="Task_ManualNotify" />
    <bpmn:sequenceFlow id="Flow_SPA_50" sourceRef="Task_ManualNotify" targetRef="Gw_MergeNotify" />
    <bpmn:sequenceFlow id="Flow_SPA_51" sourceRef="Task_Record" targetRef="Gw_JoinFinalise" />
    <bpmn:sequenceFlow id="Flow_SPA_52" sourceRef="Gw_MergeNotify" targetRef="Gw_JoinFinalise" />
    <bpmn:sequenceFlow id="Flow_SPA_53" sourceRef="Gw_JoinFinalise" targetRef="End_Allocated" />
    <bpmn:association id="Assoc_Comp_Reserve_Task_ReleaseSlot" associationDirection="One" sourceRef="Comp_Reserve" targetRef="Task_ReleaseSlot" />
  </bpmn:process>
