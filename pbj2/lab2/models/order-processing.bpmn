<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_OrderProcessing"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler" exporterVersion="5.49.0"
                  modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">

  <bpmn:process id="order-processing" name="Order Processing" isExecutable="true">

    <bpmn:startEvent id="Start_Order" name="Order received">
      <bpmn:outgoing>Flow_ToValidate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_ValidateOrder" name="Validate order &amp; check stock (worker)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-order" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToStockGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Stock" name="Valid and in stock?">
      <bpmn:incoming>Flow_ToStockGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_InStock</bpmn:outgoing>
      <bpmn:outgoing>Flow_OutOfStock</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:businessRuleTask id="Task_Priority" name="Determine priority (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="order-priority" resultVariable="deliveryPriority" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InStock</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHighValueGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_HighValue" name="High value?" default="Flow_NormalValue">
      <bpmn:incoming>Flow_ToHighValueGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_HighValue</bpmn:outgoing>
      <bpmn:outgoing>Flow_NormalValue</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Verify" name="Verify high-value order">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="order-verification" />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HighValue</bpmn:incoming>
      <bpmn:outgoing>Flow_ToVerifiedGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Verified" name="Verified?">
      <bpmn:incoming>Flow_ToVerifiedGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifiedOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_VerifiedRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Payment" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64," name="Process payment (REST)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://localhost:8091/api/payments" target="url" />
          <zeebe:input source="={paymentToken: paymentToken, amount: orderTotal, orderRef: customerRef + &#34;-&#34; + productId}" target="body" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={paymentStatus: response.body.status, transactionId: response.body.transactionId, paymentReason: response.body.reason}" />
          <zeebe:header key="retryBackoff" value="PT5S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NormalValue</bpmn:incoming>
      <bpmn:incoming>Flow_VerifiedOk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPaymentGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Payment" name="Payment approved?" default="Flow_PaymentDeclined">
      <bpmn:incoming>Flow_ToPaymentGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_Fulfilment" name="Sent to fulfilment">
      <bpmn:incoming>Flow_PaymentApproved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_PaymentDeclined" name="Payment declined">
      <bpmn:incoming>Flow_PaymentDeclined</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_OutOfStock" name="Out of stock">
      <bpmn:incoming>Flow_OutOfStock</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Invalid" name="Invalid order">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Cancelled" name="Cancelled after review">
      <bpmn:incoming>Flow_VerifiedRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToValidate" sourceRef="Start_Order" targetRef="Task_ValidateOrder" />
    <bpmn:sequenceFlow id="Flow_ToStockGateway" sourceRef="Task_ValidateOrder" targetRef="Gateway_Stock" />
    <bpmn:sequenceFlow id="Flow_InStock" name="in stock" sourceRef="Gateway_Stock" targetRef="Task_Priority">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderValid and inStock</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OutOfStock" name="out of stock" sourceRef="Gateway_Stock" targetRef="End_OutOfStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderValid and not(inStock)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invalid" name="invalid" sourceRef="Gateway_Stock" targetRef="End_Invalid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderValid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToHighValueGateway" sourceRef="Task_Priority" targetRef="Gateway_HighValue" />
    <bpmn:sequenceFlow id="Flow_HighValue" name="total &gt;= 5000" sourceRef="Gateway_HighValue" targetRef="Task_Verify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderTotal &gt;= 5000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NormalValue" name="no" sourceRef="Gateway_HighValue" targetRef="Task_Payment" />
    <bpmn:sequenceFlow id="Flow_ToVerifiedGateway" sourceRef="Task_Verify" targetRef="Gateway_Verified" />
    <bpmn:sequenceFlow id="Flow_VerifiedOk" name="approved" sourceRef="Gateway_Verified" targetRef="Task_Payment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verificationDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_VerifiedRejected" name="rejected" sourceRef="Gateway_Verified" targetRef="End_Cancelled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verificationDecision = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToPaymentGateway" sourceRef="Task_Payment" targetRef="Gateway_Payment" />
    <bpmn:sequenceFlow id="Flow_PaymentApproved" name="APPROVED" sourceRef="Gateway_Payment" targetRef="End_Fulfilment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentDeclined" name="declined" sourceRef="Gateway_Payment" targetRef="End_PaymentDeclined" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_OrderProcessing">
    <bpmndi:BPMNPlane id="Plane_OrderProcessing" bpmnElement="order-processing">
      <bpmndi:BPMNShape id="Start_Order_di" bpmnElement="Start_Order">
        <dc:Bounds x="152" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateOrder_di" bpmnElement="Task_ValidateOrder">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Stock_di" bpmnElement="Gateway_Stock" isMarkerVisible="true">
        <dc:Bounds x="395" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Priority_di" bpmnElement="Task_Priority">
        <dc:Bounds x="500" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HighValue_di" bpmnElement="Gateway_HighValue" isMarkerVisible="true">
        <dc:Bounds x="655" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Verify_di" bpmnElement="Task_Verify">
        <dc:Bounds x="760" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Verified_di" bpmnElement="Gateway_Verified" isMarkerVisible="true">
        <dc:Bounds x="915" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Payment_di" bpmnElement="Task_Payment">
        <dc:Bounds x="890" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Payment_di" bpmnElement="Gateway_Payment" isMarkerVisible="true">
        <dc:Bounds x="1055" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Fulfilment_di" bpmnElement="End_Fulfilment">
        <dc:Bounds x="1172" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_PaymentDeclined_di" bpmnElement="End_PaymentDeclined">
        <dc:Bounds x="1172" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OutOfStock_di" bpmnElement="End_OutOfStock">
        <dc:Bounds x="402" y="62" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Invalid_di" bpmnElement="End_Invalid">
        <dc:Bounds x="402" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cancelled_di" bpmnElement="End_Cancelled">
        <dc:Bounds x="1022" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_ToValidate_di" bpmnElement="Flow_ToValidate">
        <di:waypoint x="188" y="200" /><di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToStockGateway_di" bpmnElement="Flow_ToStockGateway">
        <di:waypoint x="340" y="200" /><di:waypoint x="395" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InStock_di" bpmnElement="Flow_InStock">
        <di:waypoint x="445" y="200" /><di:waypoint x="500" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OutOfStock_di" bpmnElement="Flow_OutOfStock">
        <di:waypoint x="420" y="175" /><di:waypoint x="420" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Invalid_di" bpmnElement="Flow_Invalid">
        <di:waypoint x="420" y="225" /><di:waypoint x="420" y="322" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToHighValueGateway_di" bpmnElement="Flow_ToHighValueGateway">
        <di:waypoint x="600" y="200" /><di:waypoint x="655" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HighValue_di" bpmnElement="Flow_HighValue">
        <di:waypoint x="680" y="225" /><di:waypoint x="680" y="340" /><di:waypoint x="760" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NormalValue_di" bpmnElement="Flow_NormalValue">
        <di:waypoint x="705" y="200" /><di:waypoint x="890" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToVerifiedGateway_di" bpmnElement="Flow_ToVerifiedGateway">
        <di:waypoint x="860" y="340" /><di:waypoint x="915" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_VerifiedOk_di" bpmnElement="Flow_VerifiedOk">
        <di:waypoint x="940" y="315" /><di:waypoint x="940" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_VerifiedRejected_di" bpmnElement="Flow_VerifiedRejected">
        <di:waypoint x="965" y="340" /><di:waypoint x="1022" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPaymentGateway_di" bpmnElement="Flow_ToPaymentGateway">
        <di:waypoint x="990" y="200" /><di:waypoint x="1055" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentApproved_di" bpmnElement="Flow_PaymentApproved">
        <di:waypoint x="1105" y="200" /><di:waypoint x="1172" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentDeclined_di" bpmnElement="Flow_PaymentDeclined">
        <di:waypoint x="1080" y="175" /><di:waypoint x="1080" y="100" /><di:waypoint x="1172" y="100" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>