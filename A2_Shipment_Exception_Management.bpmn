<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SHP" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.0.0">
  <bpmn:collaboration id="Collab_SHP">
    <bpmn:participant id="Pool_SHP" name="Logistics &amp; Shipment Exception Management" processRef="Process_SHP" />
  </bpmn:collaboration>
  <bpmn:message id="Msg_Cancel" name="Shipper cancellation request" />
  <bpmn:message id="Msg_Delay" name="Delay alert (weather, strike, breakdown, hub overload)" />
  <bpmn:message id="Msg_Docs" name="Customs documents" />
  <bpmn:message id="Msg_Collect" name="Recipient collects at depot" />
  <bpmn:error id="Err_Scan" name="Scanner offline / data mismatch" errorCode="SCAN_FAILED" />
  <bpmn:process id="Process_SHP" name="Courier Shipment Life Cycle with Exception Handling" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SHP">
      <bpmn:lane id="Lane_Shipper" name="Shipper / Customer">
        <bpmn:flowNodeRef>Start_Booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Correct</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Control" name="Control Tower / Dispatcher">
        <bpmn:flowNodeRef>Rule_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Comp_Charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Docs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pickup" name="Pickup Agent">
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Collected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Err_ScanBoundary</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Hub" name="Hub / Warehouse">
        <bpmn:flowNodeRef>Task_ManualScan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeTransit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_LineHaul</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reroute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StopReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Trace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_International</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DestCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Condition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformDamage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnSender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Msg_DelayB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Msg_CancelB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_NoScan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Trace</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Delivery" name="Delivery Agent">
        <bpmn:flowNodeRef>Task_NotifyRecipient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldDepot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DepotWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Collected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Expired</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Recipient" name="Recipient">
        <bpmn:flowNodeRef>Task_ConfirmAddress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Surcharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PaySurcharge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Claims" name="Claims Department">
        <bpmn:flowNodeRef>Task_DeclareLost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Claims</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Claim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
<bpmn:startEvent id="Start_Booking" name="Shipment to send">
      <bpmn:outgoing>Flow_SHP_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Book" name="Create shipment booking">
      <bpmn:incoming>Flow_SHP_01</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Correct" name="Correct booking details">
      <bpmn:incoming>Flow_SHP_04</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Rule_Validate" name="Validate address, weight &amp; compute charges">
      <bpmn:incoming>Flow_SHP_02</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_05</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_03</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_Valid" name="Booking valid?" default="Flow_SHP_06">
      <bpmn:incoming>Flow_SHP_03</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Charge" name="Collect booking charges">
      <bpmn:incoming>Flow_SHP_06</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Refund" name="Refund charges minus fee" isForCompensation="true" />
    <bpmn:serviceTask id="Task_Schedule" name="Schedule pickup &amp; assign driver">
      <bpmn:incoming>Flow_SHP_07</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_11</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Throw_Refund" name="Refund minus fee (compensate)">
      <bpmn:incoming>Flow_SHP_12</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_23</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_13</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Throw_Refund_ED" activityRef="Task_Charge" waitForCompletion="true" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_Cancelled" name="Cancelled">
      <bpmn:incoming>Flow_SHP_13</bpmn:incoming>
      <bpmn:terminateEventDefinition id="End_Cancelled_ED" />
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_Tracking" name="Update tracking &amp; notify shipper">
      <bpmn:incoming>Flow_SHP_15</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_29</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_Customs" name="Clear customs">
      <bpmn:incoming>Flow_SHP_31</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_37</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Docs" name="Documents complete?" default="Flow_SHP_34">
      <bpmn:incoming>Flow_SHP_33</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_34</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RequestDocs" name="Request documents from shipper" messageRef="Msg_Docs">
      <bpmn:incoming>Flow_SHP_35</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_36</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveDocs" name="Receive customs documents" messageRef="Msg_Docs">
      <bpmn:incoming>Flow_SHP_36</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_37</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="Task_Close" name="Close shipment &amp; raise invoice">
      <bpmn:incoming>Flow_SHP_47</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_56</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_59</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Delivered" name="Delivered &amp; closed">
      <bpmn:incoming>Flow_SHP_59</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Task_Collect" name="Collect parcel from shipper">
      <bpmn:incoming>Flow_SHP_08</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_09</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_Collected" name="Parcel collected?" default="Flow_SHP_10">
      <bpmn:incoming>Flow_SHP_09</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gw_Split">
      <bpmn:incoming>Flow_SHP_10</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_Scan" name="Scan parcel at pickup">
      <bpmn:incoming>Flow_SHP_14</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ManualScan" name="Supervisor updates scan &amp; reconciles">
      <bpmn:incoming>Flow_SHP_17</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_MergeTransit">
      <bpmn:incoming>Flow_SHP_16</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_18</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_21</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_25</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_LineHaul" name="Line-haul (per leg)" triggeredByEvent="false">
      <bpmn:incoming>Flow_SHP_19</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_28</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics id="Sub_LineHaul_MI" isSequential="true" />
      <bpmn:startEvent id="LH_Start" name="Leg starts">
        <bpmn:outgoing>Flow_SHP_64</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:manualTask id="LH_Load" name="Sort, load &amp; dispatch">
        <bpmn:incoming>Flow_SHP_64</bpmn:incoming>
        <bpmn:outgoing>Flow_SHP_65</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:userTask id="LH_Unload" name="Unload &amp; scan at next hub">
        <bpmn:incoming>Flow_SHP_65</bpmn:incoming>
        <bpmn:outgoing>Flow_SHP_66</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="LH_End" name="Leg complete">
        <bpmn:incoming>Flow_SHP_66</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SHP_64" sourceRef="LH_Start" targetRef="LH_Load" />
      <bpmn:sequenceFlow id="Flow_SHP_65" sourceRef="LH_Load" targetRef="LH_Unload" />
      <bpmn:sequenceFlow id="Flow_SHP_66" sourceRef="LH_Unload" targetRef="LH_End" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="Task_Reroute" name="Reroute / alternate vehicle, new ETA">
      <bpmn:incoming>Flow_SHP_20</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="Task_StopReturn" name="Stop movement &amp; return parcel">
      <bpmn:incoming>Flow_SHP_22</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_23</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:subProcess id="Sub_Trace" name="Trace parcel" triggeredByEvent="false">
      <bpmn:incoming>Flow_SHP_24</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_25</bpmn:outgoing>
      <bpmn:startEvent id="TR_Start" name="Trace opened">
        <bpmn:outgoing>Flow_SHP_67</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="TR_Search" name="Check last scan, manifests &amp; vehicles">
        <bpmn:incoming>Flow_SHP_67</bpmn:incoming>
        <bpmn:outgoing>Flow_SHP_68</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="TR_End" name="Parcel located">
        <bpmn:incoming>Flow_SHP_68</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SHP_67" sourceRef="TR_Start" targetRef="TR_Search" />
      <bpmn:sequenceFlow id="Flow_SHP_68" sourceRef="TR_Search" targetRef="TR_End" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="Gw_Join">
      <bpmn:incoming>Flow_SHP_28</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_29</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_30</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gw_International" name="International?" default="Flow_SHP_32">
      <bpmn:incoming>Flow_SHP_30</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_DestCheck" name="Inspect parcel at destination hub">
      <bpmn:incoming>Flow_SHP_32</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_34</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_39</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Condition" name="Parcel condition?" default="Flow_SHP_40">
      <bpmn:incoming>Flow_SHP_39</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_40</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_41</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_InformDamage" name="Record damage &amp; inform shipper">
      <bpmn:incoming>Flow_SHP_41</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_43</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_ReturnSender" name="Return to sender &amp; adjust charges">
      <bpmn:incoming>Flow_SHP_38</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_48</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_57</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_58</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Returned" name="Returned to sender">
      <bpmn:incoming>Flow_SHP_58</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_NotifyRecipient" name="Notify recipient: out for delivery">
      <bpmn:incoming>Flow_SHP_40</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_43</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_50</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_62</bpmn:incoming>
      <bpmn:incoming>Flow_SHP_63</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_45</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_Deliver" name="Deliver &amp; capture proof of delivery">
      <bpmn:incoming>Flow_SHP_45</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_46</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Outcome" name="Delivery outcome?" default="Flow_SHP_47">
      <bpmn:incoming>Flow_SHP_46</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_47</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_48</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Reason" name="Why not delivered?" default="Flow_SHP_51">
      <bpmn:incoming>Flow_SHP_49</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_50</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_51</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_52</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_HoldDepot" name="Hold at depot (7 days)">
      <bpmn:incoming>Flow_SHP_51</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_53</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gw_DepotWait" name="Collected or expired?">
      <bpmn:incoming>Flow_SHP_53</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_54</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_55</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_Collected" name="Recipient collects">
      <bpmn:incoming>Flow_SHP_54</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_56</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_Collected_ED" messageRef="Msg_Collect" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_Expired" name="7 days elapsed">
      <bpmn:incoming>Flow_SHP_55</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_57</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Catch_Expired_ED"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ConfirmAddress" name="Confirm correct address">
      <bpmn:incoming>Flow_SHP_52</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_60</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Surcharge" name="Outside original zone?" default="Flow_SHP_62">
      <bpmn:incoming>Flow_SHP_60</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_61</bpmn:outgoing>
      <bpmn:outgoing>Flow_SHP_62</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PaySurcharge" name="Pay address-change surcharge">
      <bpmn:incoming>Flow_SHP_61</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_63</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_DeclareLost" name="Declare lost, compensate &amp; notify">
      <bpmn:incoming>Flow_SHP_26</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Lost" name="Closed – lost">
      <bpmn:incoming>Flow_SHP_27</bpmn:incoming>
      <bpmn:terminateEventDefinition id="End_Lost_ED" />
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_Claims" name="Claim: refund / replace / reship" triggeredByEvent="false">
      <bpmn:incoming>Flow_SHP_42</bpmn:incoming>
      <bpmn:outgoing>Flow_SHP_44</bpmn:outgoing>
      <bpmn:startEvent id="CL_Start" name="Claim raised">
        <bpmn:outgoing>Flow_SHP_69</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="CL_Assess" name="Assess claim &amp; evidence">
        <bpmn:incoming>Flow_SHP_69</bpmn:incoming>
        <bpmn:outgoing>Flow_SHP_70</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="CL_Settle" name="Refund, replace or reship">
        <bpmn:incoming>Flow_SHP_70</bpmn:incoming>
        <bpmn:outgoing>Flow_SHP_71</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="CL_End" name="Claim settled">
        <bpmn:incoming>Flow_SHP_71</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SHP_69" sourceRef="CL_Start" targetRef="CL_Assess" />
